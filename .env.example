# admin connection: migrations only (needs DDL privileges)
DATABASE_URL=postgres://user:password@localhost:5432/command_center
# app runtime connection: restricted non-superuser role, subject to RLS
APP_DATABASE_URL=postgres://command_center_app:password@localhost:5432/command_center
REDIS_URL=redis://localhost:6379
API_PORT=3001
SESSION_SECRET=change-me

# Knowledge base file attachments (Google Cloud Storage)
GCS_BUCKET_NAME=command-center-attachments
# base64-encoded service-account JSON key (base64 -i key.json; not a random key, so not hex)
GCS_SERVICE_ACCOUNT_KEY=

# Slack bots live in slack_connections (encrypted) + slack_routes.
# Manage via /slack in the UI. REQUIRED: the KEK that encrypts stored
# bot tokens. Use a dedicated value, not SESSION_SECRET — rotating it
# would silently invalidate every stored bot token.
SLACK_ENCRYPTION_SECRET=
# Automations Worker callback endpoint (Phase 4 — Slack button click delivery)
WORKER_CALLBACK_URL=http://automations-worker:3005
WORKER_CALLBACK_TOKEN=

# Login password reset emails (plain SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# Used to build the reset link sent by email
APP_URL=http://localhost:3010

# CA invoice PDF rendering (headless Chrome renders the invoice HTML template)
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Local Ollama drafts the monthly CA email body
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Worker routes
WORKER_CALLBACK_URL=http://localhost:3005
WORKER_CALLBACK_TOKEN=5d9dff4974af8b1fb8dde547f71e14ac56efb7da179700c2693f54ac6a5d1b71
NEXT_PUBLIC_WORKER_URL=https://commandcenter.pametnitech.com/automations

# Temporal 
TEMPORAL_ADDRESS=chandu-h110:7233
TEMPORAL_NAMESPACE=commandcenter
# Must match the worker's queue (default personal-automations) — grant toggles create schedules on it
TEMPORAL_TASK_QUEUE=personal-automations

# Web → API proxy origin (prod: http://localhost:3011)
API_ORIGIN=http://localhost:3001

# Encryption keys for stored per-user secrets (BYOK API keys, pilgrim IDs): openssl rand -hex 32
# Keep the same values forever — changing them makes existing rows undecryptable.
USER_CREDENTIALS_DEK=
PILGRIM_IDENTITIES_DEK=
