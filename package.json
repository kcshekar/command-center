{
  "name": "command-center",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:api": "bun --hot apps/api/index.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit -p apps/api && bun x tsc --noEmit -p apps/web",
    "migrate": "bun run apps/api/migrations/run.ts",
    "db:backup": "./apps/api/scripts/backup-db.sh",
    "db:restore": "./apps/api/scripts/restore-db.sh"
  },
  "devDependencies": {
    "bun-types": "^1.4.0"
  }
}
