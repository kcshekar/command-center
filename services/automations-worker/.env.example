# PostgreSQL for the worker's own DB (encrypted Google tokens + Gmail cursors).
# Create this DB and role separately from command_center.
AUTOMATIONS_DATABASE_URL=postgres://automations_app:password@localhost:5432/automations

# Envelope-encryption KEK for Google refresh tokens at rest. 32+ random bytes.
AUTOMATIONS_ENCRYPTION_SECRET=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=personal
TEMPORAL_TASK_QUEUE=personal-automations

# Command Center
CC_BASE_URL=http://command-center-api:3001
CC_SERVICE_TOKEN=cc_st_...

# Google OAuth 2.0 client (create in GCP console -> OAuth client -> Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser-based auth: served by the worker's own callback server (see
# src/callback-server.ts). Must match the Authorized redirect URI you added
# to your Desktop-app OAuth client in the GCP console.
GOOGLE_REDIRECT_URI=http://localhost:3005/auth/google/callback

# A7 — GitHub OAuth App (user settings → Developer settings → OAuth Apps).
# Scopes requested at consent time: public_repo, repo.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3005/auth/github/callback

# Local Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Slack route keys used by workflows.
SLACK_ROUTE_DIGEST=automations.digest
SLACK_ROUTE_APPROVAL=automations.approval

# Callback server: CC posts approval decisions here. Match the same
# WORKER_CALLBACK_URL/TOKEN pair in Command Center's .env.
WORKER_CALLBACK_PORT=3005
WORKER_CALLBACK_TOKEN=

# Day boundaries for reports and schedules
SCHEDULE_TIMEZONE=Asia/Kolkata

# Temporal payload encryption key (AES-256-GCM). Generate: openssl rand -hex 32 (64 hex chars).
# Same value on every worker/client; losing it makes encrypted workflow history unreadable.
TEMPORAL_PAYLOAD_DEK=

# Codec server for the Temporal Web UI (pnpm codec-server; binds 127.0.0.1). Comma-separated UI origins.
CODEC_CORS_ORIGINS=http://localhost:8233

# P1.4: CC user whose /brain lessons the monthly upgrade scan checks (unset = skip). Re-run pnpm schedules:init after setting.
PLATFORM_OWNER_USER_ID=
